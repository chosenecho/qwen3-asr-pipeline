# Copy this file to .env and fill in your values.
# Never commit .env to Git.

# Default local / self-hosted Qwen3-ASR endpoint
ASR_BASE_URL=http://127.0.0.1:6006
ASR_API_KEY=

# Optional Modal endpoint (--endpoint modal)
ASR_MODAL_BASE_URL=https://<your-workspace>--qwen3-asr-server-serve.us-east.modal.run
ASR_MODAL_API_KEY=
ASR_MODAL_KEY=
ASR_MODAL_SECRET=
ASR_MODAL_INCLUDE_WORDS=true
